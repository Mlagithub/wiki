title: $:/plugins/kookma/todolist/macros/interstitial-utility
type: text/vnd.tiddlywiki

\define todolist-input-journal()
<$keyboard key="escape" actions=<<todolist-cancel-journal-action>>>
<$edit-text
 tiddler=<<stateTiddler>>
 index="itemtext"
 tag="textarea"
 rows="2"
 class="kk-todolist-input"
 placeholder="写下此刻想法… 支持 TW 语法：* 列表、** 子列表、> 引用、## 标题"
/>
</$keyboard>
<$reveal stateTitle=<<stateTiddler>> stateIndex="itemtext" type="nomatch" text="" tag="div" class="kk-todolist-preview">
<$set name="story-render" value={{{ [<stateTiddler>getindex[itemtext]] }}}>
<$transclude $variable="story-render" $mode="block"/>
</$set>
</$reveal>
\end

\define todolist-add-journal()
<$button class="tc-btn-invisible" tooltip="Add new item">
	{{$:/core/images/new-button}}
	<<todolist-add-journal-action>>
</$button>
\end

\define todolist-add-journal-action()
  <$list filter="[<stateTiddler>getindex[itemtext]!is[blank]]" variable=ignor>
	<$set name=item value=<<now "[UTC]YYYY0MM0DD0hh0mm0ssXXX">> >
	<$action-setfield
	 $tiddler=<<taskTiddler>>
	 $index=<<item>>
	 $value={{{ [<stateTiddler>getindex[itemtext]] }}}
	/>
	</$set>
	<$action-setfield $tiddler=<<stateTiddler>> $index="itemtext" $value=""/>
	</$list>
\end

\define todolist-cancel-journal-action()
 <$action-setfield $tiddler=<<stateTiddler>> $index="itemtext" $value=""/>
\end


\define todolist-delete-journal(dataTiddler)
<$button class="tc-btn-invisible">
{{$:/plugins/kookma/todolist/images/times.svg}}
<$action-setfield $tiddler=<<__dataTiddler__>> $index=<<item>> />
</$button>
\end

\define disp-journals-in-view-mode()
\whitespace trim
<$list filter="[<taskTiddler>indexes[]format:date[YYYY0MM0DD]unique[]sort[]reverse[yes]limit[5]]" variable="dateGroup">
<div class="kk-todolist-date-group">
<div class="kk-todolist-date-header"><$text text={{{ [<dateGroup>format:date[0MM-0DD]] }}}/></div>
<$list filter="[<taskTiddler>indexes[]prefix<dateGroup>sort[]]" variable="item">
<div class="kk-todolist-row">
  <div class="kk-todolist-time"><$text text={{{ [<item>format:date[0hh:0mm]] }}}/></div>
  <div class="kk-todolist-desc"><$set name="story-render" value={{{ [<taskTiddler>getindex<item>] }}}>
<$transclude $variable="story-render" $mode="block"/>
</$set></div>
</div>
</$list>
</div>
</$list>
\end

\define disp-journals-in-edit-mode()
\whitespace trim
<$list filter="[<taskTiddler>indexes[]format:date[YYYY0MM0DD]unique[]sort[]reverse[yes]limit[5]]" variable="dateGroup">
<div class="kk-todolist-date-group">
<div class="kk-todolist-date-header"><$text text={{{ [<dateGroup>format:date[0MM-0DD]] }}}/></div>
<$list filter="[<taskTiddler>indexes[]prefix<dateGroup>sort[]]" variable="item">
<div class="kk-todolist-row">
  <div class="kk-todolist-time"><$text text={{{ [<item>format:date[0hh:0mm]] }}}/></div>
  <div class="kk-todolist-desc"><$edit-text tiddler=<<taskTiddler>> index=<<item>> tag="textarea" rows="2" class="kk-todolist-edit"/>
<div class="kk-todolist-edit-preview"><$set name="story-render" value={{{ [<taskTiddler>getindex<item>] }}}>
<$transclude $variable="story-render" $mode="block"/>
</$set></div></div>
  <div class="kk-todolist-delete"><$macrocall $name="todolist-delete-journal" dataTiddler=<<taskTiddler>>/></div>
</div>
</$list>
</div>
</$list>
\end
