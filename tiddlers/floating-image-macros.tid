\define image-left(name, width:"33%", tooltip, caption)
\whitespace trim
<div class="image-float-left" style={{{ "width:" [<__width__>] +[join[]] }}} >
  <div><$image source=<<__name__>> width="100%" tooltip=<<__tooltip__>> /></div>
  <<__caption__>>
</div>
\end

