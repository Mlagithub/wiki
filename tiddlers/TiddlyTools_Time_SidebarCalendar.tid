title: TiddlyTools/Time/SidebarCalendar
type: text/vnd.tiddlywiki

\define tt_time_config() $:/config/TiddlyTools/Time

\import TiddlyTools/Time/Calendar
\whitespace trim
<$vars here="TiddlyTools/Time/SidebarCalendar"> <!-- needed for SideBar -->
<$tiddler tiddler=<<calendar_state>>>
<$vars thisyear=<<now "YYYY">> thismonth=<<now "MM">>>
<$vars yyyy={{{ [{!!year}!match[]else<thisyear>] }}} mm={{{ [{!!month}!match[]else<thismonth>] }}}>
<$vars calendar_size={{{ [<tt_time_config>get[sidebar_calendar_size]] ~[[100]] }}} calendar_popup_pos="belowleft">
<span style={{{ [[font-size:]addsuffix<calendar_size>addsuffix[%;]] }}}>
<$macrocall $name="showmonth" yyyy=<<yyyy>> mm=<<mm>> view="month_only" />