```cpp
#ifdef __GNUC__
#include <cxxabi.h>
namespace {
    std::string demangle(const std::string& mangled) {
        int status;
        char* realname =
            abi::__cxa_demangle(mangled.c_str(), nullptr, nullptr, &status);
        std::string result(realname);
        free(realname);
        return result;
    }
}
#else
namespace {
    std::string demangle(const std::string& mangled) {
        return mangled;
    }
}
#endif
