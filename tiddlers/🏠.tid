\define createTodo()
<$action-sendmessage 
  $message="tm-new-tiddler" 
  title="New Todo" 
  tags="todo" 
  text=""
  due-date=""
  priority="normal"
  status="not started"
  />
\end

\define newTodo()
<$button actions=<<createTodo>> class="btn btn-sm btn-info" >创建任务
</$button>
\end

